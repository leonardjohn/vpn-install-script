# Copy to server.env and edit locally.
# ADDRESS_MODE is either: domain | ipv4
ADDRESS_MODE=domain

# Client connection address. Domain mode: your own DNS hostname.
# IPv4 mode: the VPS public IPv4 address.
SERVER_ADDRESS=reality-rn.btphost.com

# Optional owned domain. Required in domain mode; leave empty in IPv4 mode.
BASE_DOMAIN=btphost.com

# REALITY listener settings. SNI is always an explicit hostname, even in IPv4 mode.
REALITY_PORT=9444
REALITY_TARGET=127.0.0.1:9443
REALITY_SNI=web-rn.btphost.com
REALITY_FLOW=xtls-rprx-vision
REALITY_MIN_CLIENT_VER=1.8.2

# Certificate mode for the non-REALITY TLS services.
# Domain mode: acme (publicly trusted certificate).
# IPv4 mode: self_signed (IP SAN); clients need an explicit trust/insecure policy.
TLS_CERT_MODE=acme
TLS_CERT_HOST=web-rn.btphost.com

# Optional subscription hostname. In IPv4 mode this can be blank; the later
# installer can publish an IP-based HTTPS URL only with an explicit trust policy.
SUBSCRIPTION_HOST=sub-rn.btphost.com
