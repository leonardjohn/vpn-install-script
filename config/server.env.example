# Copy to server.env and edit locally. Do not commit/share server.env.
# domain = owned DNS hostname; ipv4 = public IPv4 address only.
ADDRESS_MODE=domain
SERVER_ADDRESS=reality-rn.btphost.com
BASE_DOMAIN=btphost.com

# REALITY settings. SNI must be an explicitly selected, supported hostname.
REALITY_TARGET=127.0.0.1:9443
REALITY_SNI=web-rn.btphost.com
REALITY_FLOW=xtls-rprx-vision
REALITY_MIN_CLIENT_VER=1.8.2

# Domain mode: acme + TLS_CERT_HOST. IPv4 mode: self_signed + empty TLS_CERT_HOST.
TLS_CERT_MODE=acme
TLS_CERT_HOST=web-rn.btphost.com
ACME_EMAIL=replace-with-your-email@example.com

# Domain mode: subscription hostname. IPv4 mode: leave empty in this release.
SUBSCRIPTION_HOST=sub-rn.btphost.com

# RackNerd port profile. Do not change without updating firewall/client templates.
REALITY_PORT=9444
XHTTP_PORT=9445
ANYTLS_PORT=2053
HY2_PORT=8444
TUIC_PORT=8445
SS_PORT=8388
TROJAN_PORT=8446
VMESS_PORT=8447
SUBSCRIPTION_PORT=9446
FALLBACK_PORT=9443
