# Example only. Replace SERVER_ADDRESS and REALITY_SNI deliberately.
ADDRESS_MODE=ipv4
SERVER_ADDRESS=198.51.100.10
BASE_DOMAIN=
REALITY_PORT=9444
REALITY_TARGET=127.0.0.1:9443
REALITY_SNI=www.example.com
REALITY_FLOW=xtls-rprx-vision
REALITY_MIN_CLIENT_VER=1.8.2
TLS_CERT_MODE=self_signed
TLS_CERT_HOST=
ACME_EMAIL=
SUBSCRIPTION_HOST=
XHTTP_PORT=9445
ANYTLS_PORT=2053
HY2_PORT=8444
TUIC_PORT=8445
SS_PORT=8388
TROJAN_PORT=8446
VMESS_PORT=8447
SUBSCRIPTION_PORT=9446
FALLBACK_PORT=9443

# Self-signed certificate paths (certificate SAN must include REALITY_SNI and SERVER_ADDRESS).
TLS_CERT_FILE=/etc/ssl/vpn/shared/fullchain.pem
TLS_KEY_FILE=/etc/ssl/vpn/shared/private.key
