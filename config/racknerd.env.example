# Copy to racknerd.env and edit before installation. Keep mode 600.
SERVER_ID="racknerd"
SERVER_IPV4="198.44.36.67"
BASE_DOMAIN="btphost.com"

REALITY_HOST="reality-rn.btphost.com"
XHTTP_HOST="xhttp-rn.btphost.com"
ANYTLS_HOST="anytls-rn.btphost.com"
HY2_HOST="hy2-rn.btphost.com"
TUIC_HOST="tuic-rn.btphost.com"
SS_HOST="ss-rn.btphost.com"
TROJAN_HOST="trojan-rn.btphost.com"
VMESS_HOST="vmess-rn.btphost.com"
WEB_HOST="web-rn.btphost.com"
SUB_HOST="sub-rn.btphost.com"

# Pin tested versions; change only after separate validation.
XRAY_VERSION="26.10.31"
SINGBOX_VERSION="1.14.4"

# Ports — do not change without updating firewall rules and profile generator.
PORT_REALITY="9444"
PORT_XHTTP="9445"
PORT_ANYTLS="2053"
PORT_HY2="8444"
PORT_TUIC="8445"
PORT_SS="8388"
PORT_TROJAN="8446"
PORT_VMESS="8447"
PORT_SUB="9446"
PORT_FALLBACK="9443"

# REALITY camouflage target. Client SNI must match this value.
REALITY_DEST="www.microsoft.com:443"
REALITY_SNI="www.microsoft.com"

# Optional: set a path component for XHTTP. Keep it non-empty and hard to guess.
XHTTP_PATH="/xhttp-rn"

# Contact email for ACME account registration.
ACME_EMAIL="lxs647@gmail.com"
